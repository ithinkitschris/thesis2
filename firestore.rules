rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Risk Trust Matrix Collection
    // Allow authenticated users to read all entries and create new ones
    match /riskTrustMatrix/{document} {
      // Allow anyone (including anonymous users) to read all data points
      allow read: if request.auth != null;
      
      // Allow authenticated users to create new data points
      allow create: if request.auth != null
                    && request.resource.data.keys().hasAll(['userId', 'sessionId', 'label', 'riskPercent', 'trustPercent', 'timestamp'])
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.riskPercent >= 0
                    && request.resource.data.riskPercent <= 100
                    && request.resource.data.trustPercent >= 0
                    && request.resource.data.trustPercent <= 100;
      
      // Allow users to delete only their own entries
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
      
      // Prevent updates for data integrity
      allow update: if false;
    }
    
    // Testimonials Collection (if you have one)
    match /testimonials/{document} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
  }
}
